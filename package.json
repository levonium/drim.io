{
  "name": "drim.io",
  "version": "50.2.0",
  "description": "My personal website",
  "main": "index.js",
  "scripts": {
    "css-watch": "npx @tailwindcss/cli -i ./resources/css/app.css -o ./assets/css/app.css --watch",
    "css-build": "npx @tailwindcss/cli -i ./resources/css/app.css -o ./assets/css/app.css --build --minify",
    "copy": "cp -R ./assets ./dist && cp ./root_files/* ./dist",
    "build": "rm -rf dist && mkdir dist && php build.php && npm run css-build && npm run copy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.8",
    "lucide-static": "^0.473.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.8"
  }
}
